{
  "name": "zarr-metadata",
  "version": "0.1.0",
  "description": "Spec-defined metadata types and validators for Zarr v2 and v3.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d-v-b/zarr-metadata-ts.git"
  },
  "homepage": "https://github.com/d-v-b/zarr-metadata-ts#readme",
  "bugs": {
    "url": "https://github.com/d-v-b/zarr-metadata-ts/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "keywords": [
    "zarr",
    "metadata",
    "validation"
  ],
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26.4.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
